<div class="container mt-4">
  <h2 class="mb-4">Company Metrics</h2>

  <table class="table table-striped table-bordered">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Ticker</th>
        <th>Sub-Sector</th>
        <th>Market Cap</th>
        <th>Close Price</th>
        <th>PE Ratio</th>
        <th>Actions</th>

      </tr>
    </thead>
    <tbody>
      <% @company_metrics.each do |metric| %>
        <tr>
          <td><%= metric.name %></td>
          <td><%= metric.ticker %></td>
          <td><%= metric.sub_sector %></td>
          <td><%= number_to_currency(metric.market_cap, unit: "₹", precision: 0, delimiter: ",") %></td>
          <td><%= number_with_precision(metric.close_price, precision: 2) %></td>
          <td><%= number_with_precision(metric.pe_ratio, precision: 2) %></td>
          <td><%= link_to  "Fundamental Analysis", company_analysis_path(id: metric.id), data: { turbo: false } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="d-flex justify-content-center my-4">
    <%= paginate @company_metrics %>
  </div>
</div>
